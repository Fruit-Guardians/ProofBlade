{
  "schemaVersion": 1,
  "runtime": {
    "piVersion": "0.83.0"
  },
  "storage": {
    "runsDir": "runs/real-evaluation-aihub-terra-max",
    "fixturesDir": "fixtures/real-evaluation-aihub-terra-max"
  },
  "modelProfiles": {
    "executor": {
      "provider": "aihub",
      "api": "openai-responses",
      "baseUrl": "https://aihub.top/v1",
      "model": "gpt-5.6-terra",
      "thinkingLevel": "max",
      "reasoning": true,
      "supportsReasoningEffort": true,
      "responsesStreaming": "sse",
      "apiKeyEnv": "PROOFBLADE_EVAL_AIHUB_API_KEY",
      "contextWindow": 32768,
      "maxTokens": 16384,
      "requestTimeoutMs": 120000,
      "maxRetries": 0,
      "input": ["text", "image"],
      "pricing": {
        "inputUsdPerMillion": 1,
        "outputUsdPerMillion": 1,
        "cacheReadUsdPerMillion": 0,
        "cacheWriteUsdPerMillion": 0
      }
    }
  }
}
