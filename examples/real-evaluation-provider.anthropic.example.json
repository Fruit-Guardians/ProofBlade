{
  "schemaVersion": 1,
  "runtime": {
    "piVersion": "0.83.0"
  },
  "storage": {
    "runsDir": "runs/real-evaluation-anthropic",
    "fixturesDir": "fixtures/real-evaluation-anthropic"
  },
  "modelProfiles": {
    "executor": {
      "provider": "anthropic",
      "api": "anthropic-messages",
      "baseUrl": "https://api.anthropic.com",
      "model": "replace-with-priced-anthropic-model",
      "modelDiscoveryPath": "/v1/models",
      "apiKeyEnv": "PROOFBLADE_EVAL_ANTHROPIC_API_KEY",
      "contextWindow": 200000,
      "maxTokens": 16384,
      "requestTimeoutMs": 120000,
      "maxRetries": 0,
      "input": ["text", "image"],
      "pricing": {
        "inputUsdPerMillion": 1,
        "outputUsdPerMillion": 1,
        "cacheReadUsdPerMillion": 0,
        "cacheWriteUsdPerMillion": 0
      }
    }
  }
}
