# The provider and model are selected in proofblade.config.json.
# LM Studio accepts a placeholder key unless authentication is enabled.
LMSTUDIO_API_KEY=lm-studio

# Local aihub / OpenAI-compatible Provider profile (for .proofblade/aihub.config.json).
# Keep the value only in your local ignored environment; never commit the key.
# PROOFBLADE_AIHUB_API_KEY=

# Real evaluation only: set these in the shell that launches eval-real.
# Replace the model and published token prices in the example provider configs first.
# PROOFBLADE_EVAL_OPENAI_API_KEY=
# PROOFBLADE_EVAL_ANTHROPIC_API_KEY=
# DeepSeek-compatible real evaluation variants can share one key.
# PROOFBLADE_EVAL_DEEPSEEK_API_KEY=
# OpenAI-compatible aihub real evaluation profile.
# PROOFBLADE_EVAL_AIHUB_API_KEY=

# DASCTF-specific overrides. Keep the AccessKey outside competition.json when possible.
# PROOFBLADE_COMPETITION_SERVER_HOST=https://gcsis.dasctf.com
# PROOFBLADE_COMPETITION_ACCESS_KEY=
# Comma-separated confirmed wrong-flag response codes; an empty value enables strict mode.
# PROOFBLADE_COMPETITION_WRONG_FLAG_CODES=40001

# Optional durable Browser Runtime Service. Once runtime.browserBroker is set,
# Browser transport tasks require this token and a deployment-provided host;
# they never silently fall back to process-local Playwright.
# PROOFBLADE_BROWSER_RUNTIME_TOKEN=
# Defaults to scripts/browser-runtime-playwright-host.ts when omitted. Override
# only when deploying a reviewed BrowserRuntimeHost implementation.
# PROOFBLADE_BROWSER_RUNTIME_HOST_MODULE=scripts/browser-runtime-playwright-host.ts
# PROOFBLADE_BROWSER_RUNTIME_LEDGER=.proofblade/browser-runtime.json
# PROOFBLADE_BROWSER_RUNTIME_HOST=127.0.0.1
# PROOFBLADE_BROWSER_RUNTIME_PORT=43121
# Set to 1 for deployment startup to refuse a non-READY/non-restart-stable host.
# PROOFBLADE_BROWSER_RUNTIME_REQUIRE_READY=1

# Optional durable Pwn/HTTP Session Runtime broker. The client is enabled only
# when runtime.sessionBroker is configured; the token is never persisted in a
# Run, Artifact, or generated API document.
# PROOFBLADE_SESSION_RUNTIME_TOKEN=
# Set to 1 for deployment startup to refuse a non-READY/non-restart-stable host.
# PROOFBLADE_SESSION_RUNTIME_REQUIRE_READY=1
# Optional reference host for stateful HTTP sessions. It exposes only
# http-session; Pwn still requires a separately deployed supervisor host.
# PROOFBLADE_SESSION_RUNTIME_HOST_MODULE=scripts/session-runtime-http-host.ts
# To expose both session kinds behind one broker, use the explicit combined
# adapter below; it still requires a restart-stable Pwn supervisor module.
# PROOFBLADE_SESSION_RUNTIME_HOST_MODULE=scripts/session-runtime-combined-host.ts
# PROOFBLADE_HTTP_SESSION_STATE=.proofblade/http-session-host.json
# Required by the reference host for encrypted cookie/CSRF state at rest.
# PROOFBLADE_SESSION_RUNTIME_STATE_KEY=
# Pwn-only host adapter: the generic service loads this adapter, which then
# loads a deployment-owned supervisor exposing createPwnSessionSupervisor().
# It must be paired with PROOFBLADE_PWN_SUPERVISOR_MODULE and a real
# restart-stable process/tube supervisor; the adapter never launches a local
# replacement process by itself.
# PROOFBLADE_PWN_SUPERVISOR_MODULE=
# Optional built-in detached-worker supervisor module:
# PROOFBLADE_PWN_SUPERVISOR_MODULE=scripts/pwn-supervisor-host.ts
# PROOFBLADE_PWN_SUPERVISOR_STATE=.proofblade/pwn-supervisor.json
# PROOFBLADE_PWN_WORKER_SCRIPT=scripts/pwn-session-worker.mjs
# PROOFBLADE_PWN_SUPERVISOR_TIMEOUT_MS=15000
# Host-local command execution is disabled by default. Enable only in an
# isolated development runner; production deployments should use a Docker or
# remote-tube supervisor and leave this unset.
# PROOFBLADE_PWN_ALLOW_LOCAL_COMMANDS=1
# Optional controlled Docker target. The container is deployment-owned and
# commands are checked by executable name before the worker launches `docker exec`.
# PROOFBLADE_PWN_DOCKER_CONTAINER=proofblade-pwn-target
# PROOFBLADE_PWN_DOCKER_ALLOWED_COMMANDS=/app/challenge
# PROOFBLADE_PWN_DOCKER_EXECUTABLE=docker
# PROOFBLADE_PWN_DOCKER_ALLOW_SHELL=0
# Optional release smoke for the fixed Docker target. Pin this to an image
# digest (or an immutable registry reference); the smoke never pulls or talks
# to a CTF service. The ordinary command skips without Docker/image access,
# while `pwn:docker:smoke:required` fails the deployment gate. The fault matrix
# commands use the same image and exercise all cross-ledger crash boundaries.
# PROOFBLADE_PWN_SMOKE_IMAGE=
# Optional path for an atomic, machine-readable fault-matrix evidence report;
# deployment pipelines should archive it as a release artifact.
# PROOFBLADE_PWN_FAULT_MATRIX_REPORT=.proofblade/pwn-fault-matrix.json
# Optional path for an atomic Browser smoke evidence report. The report records
# pass/skip and deployment identity without storing page contents or secrets.
# PROOFBLADE_BROWSER_SMOKE_REPORT=.proofblade/browser-smoke.json
# Remote raw TCP is fail-closed unless the deployment allowlists both host and
# port. Values are comma-separated; do not use '*' in production.
# PROOFBLADE_PWN_REMOTE_ALLOWED_HOSTS=127.0.0.1
# PROOFBLADE_PWN_REMOTE_ALLOWED_PORTS=31337
