{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "mcp-registry",
      "sourceGlobs": ["packages/materials/src/mcp/**"],
      "testGlobs": ["packages/materials/tests/mcp.test.ts"],
      "command": "node --import tsx --test packages/materials/tests/mcp.test.ts"
    },
    {
      "id": "competition-runtime",
      "sourceGlobs": ["packages/materials/src/competition/**"],
      "testGlobs": [
        "packages/materials/tests/competition-api.test.ts",
        "packages/materials/tests/dasctf-api.test.ts",
        "packages/materials/tests/competition-fleet.test.ts",
        "packages/materials/tests/competition-control-plane.test.ts",
        "packages/materials/tests/competition-solver.test.ts",
        "packages/materials/tests/environment-janitor.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/competition-api.test.ts packages/materials/tests/dasctf-api.test.ts packages/materials/tests/competition-fleet.test.ts packages/materials/tests/competition-control-plane.test.ts packages/materials/tests/competition-solver.test.ts packages/materials/tests/environment-janitor.test.ts"
    },
    {
      "id": "runtime-recovery",
      "sourceGlobs": [
        "packages/materials/src/runtime/**",
        "packages/materials/src/context/**",
        "packages/materials/src/recovery/**",
        "packages/materials/src/observability/**",
        "packages/materials/src/effects/**"
      ],
      "testGlobs": [
        "packages/materials/tests/coding-resources.test.ts",
        "packages/materials/tests/context.test.ts",
        "packages/materials/tests/context-recovery.test.ts",
        "packages/materials/tests/interruption-recovery.test.ts",
        "packages/materials/tests/observability.test.ts",
        "packages/materials/tests/durability.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/coding-resources.test.ts packages/materials/tests/context.test.ts packages/materials/tests/context-recovery.test.ts packages/materials/tests/interruption-recovery.test.ts packages/materials/tests/observability.test.ts packages/materials/tests/durability.test.ts"
    },
    {
      "id": "agent-orchestration",
      "sourceGlobs": ["packages/materials/src/orchestration/**"],
      "testGlobs": [
        "packages/materials/tests/single-agent-loop.test.ts",
        "packages/materials/tests/context-recovery.test.ts",
        "packages/materials/tests/evaluation.test.ts",
        "packages/materials/tests/real-model-evaluator.test.ts",
        "packages/materials/tests/local-holdout.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/single-agent-loop.test.ts packages/materials/tests/context-recovery.test.ts packages/materials/tests/evaluation.test.ts packages/materials/tests/real-model-evaluator.test.ts packages/materials/tests/local-holdout.test.ts"
    },
    {
      "id": "web-pwn-verification",
      "sourceGlobs": [
        "packages/materials/src/web/**",
        "packages/materials/src/pwn/**",
        "packages/materials/src/verification/**",
        "packages/materials/src/container/**"
      ],
      "testGlobs": [
        "packages/materials/tests/web-session.test.ts",
        "packages/materials/tests/pwn-layer.test.ts",
        "packages/materials/tests/pwn-tools.test.ts",
        "packages/materials/tests/pwn-coding-tools.test.ts",
        "packages/materials/tests/competition-pwn-e2e.test.ts",
        "packages/materials/tests/container-runtime.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/web-session.test.ts packages/materials/tests/pwn-layer.test.ts packages/materials/tests/pwn-tools.test.ts packages/materials/tests/pwn-coding-tools.test.ts packages/materials/tests/competition-pwn-e2e.test.ts packages/materials/tests/container-runtime.test.ts"
    },
    {
      "id": "control-and-evidence",
      "sourceGlobs": [
        "packages/materials/src/control/**",
        "packages/materials/src/domain/**",
        "packages/materials/src/knowledge/**"
      ],
      "testGlobs": [
        "packages/materials/tests/control-store.test.ts",
        "packages/materials/tests/competition-convergence.test.ts",
        "packages/materials/tests/handoff.test.ts",
        "packages/materials/tests/evidence-curation-gate.test.ts",
        "packages/materials/tests/interruption-recovery.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/control-store.test.ts packages/materials/tests/competition-convergence.test.ts packages/materials/tests/handoff.test.ts packages/materials/tests/evidence-curation-gate.test.ts packages/materials/tests/interruption-recovery.test.ts"
    },
    {
      "id": "evaluation",
      "sourceGlobs": [
        "packages/materials/src/evaluation/**",
        "packages/materials/src/sandbox/**"
      ],
      "testGlobs": [
        "packages/materials/tests/evaluation.test.ts",
        "packages/materials/tests/runtime-scenario-evaluator.test.ts",
        "packages/materials/tests/real-model-evaluator.test.ts",
        "packages/materials/tests/local-holdout.test.ts",
        "packages/materials/tests/demo.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/evaluation.test.ts packages/materials/tests/runtime-scenario-evaluator.test.ts packages/materials/tests/real-model-evaluator.test.ts packages/materials/tests/local-holdout.test.ts packages/materials/tests/demo.test.ts"
    },
    {
      "id": "gui-settings",
      "sourceGlobs": ["apps/gui/src/competition-settings.ts"],
      "testGlobs": ["apps/gui/tests/competition-settings.test.ts"],
      "command": "node --import tsx --test apps/gui/tests/competition-settings.test.ts"
    },
    {
      "id": "capability-routing",
      "sourceGlobs": ["packages/materials/src/capabilities/**"],
      "testGlobs": [
        "packages/materials/tests/capability-backend.test.ts",
        "packages/materials/tests/capability-jobs.test.ts",
        "packages/materials/tests/tool-catalog.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/capability-backend.test.ts packages/materials/tests/capability-jobs.test.ts packages/materials/tests/tool-catalog.test.ts"
    },
    {
      "id": "tool-runtime",
      "sourceGlobs": ["packages/materials/src/tools/**"],
      "testGlobs": [
        "packages/materials/tests/coding-resources.test.ts",
        "packages/materials/tests/tool-repeat-breaker.test.ts",
        "packages/materials/tests/tool-catalog.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/coding-resources.test.ts packages/materials/tests/tool-repeat-breaker.test.ts packages/materials/tests/tool-catalog.test.ts"
    },
    {
      "id": "materials-public-surface",
      "sourceGlobs": ["packages/materials/src/index.ts"],
      "testGlobs": ["packages/materials/tests/demo.test.ts"],
      "command": "node --import tsx --test packages/materials/tests/demo.test.ts"
    },
    {
      "id": "app-server-security",
      "sourceGlobs": [
        "packages/materials/src/control/app-server.ts",
        "packages/materials/src/security/**"
      ],
      "testGlobs": [
        "packages/materials/tests/app-server.test.ts",
        "packages/materials/tests/approval-policy.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/app-server.test.ts packages/materials/tests/approval-policy.test.ts"
    },
    {
      "id": "gui-server-control",
      "sourceGlobs": ["apps/gui/src/server.ts", "apps/gui/src/debug-data.ts"],
      "testGlobs": [
        "packages/materials/tests/app-server.test.ts",
        "apps/gui/tests/competition-settings.test.ts",
        "apps/gui/tests/debug-data.test.ts"
      ],
      "command": "node --import tsx --test packages/materials/tests/app-server.test.ts apps/gui/tests/competition-settings.test.ts apps/gui/tests/debug-data.test.ts"
    },
    {
      "id": "cli-entrypoint",
      "sourceGlobs": ["apps/cli/src/main.ts"],
      "testGlobs": ["packages/materials/tests/single-agent-loop.test.ts"],
      "command": "node --import tsx --test packages/materials/tests/single-agent-loop.test.ts"
    }
  ]
}
