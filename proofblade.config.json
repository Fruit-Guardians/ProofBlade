{
  "schemaVersion": 1,
  "runtime": {
    "piVersion": "0.83.0"
  },
  "storage": {
    "runsDir": "runs",
    "fixturesDir": "fixtures/runtime"
  },
  "execution": {
    "backend": "docker",
    "requireFor": ["web", "pwn"],
    "dockerCommand": "docker",
    "networkPolicy": "target-only",
    "pullPolicy": "if-missing",
    "images": {
      "web": "proofblade/ctf-web:latest",
      "pwn": "proofblade/ctf-pwn:latest",
      "pwn-kernel": "proofblade/ctf-pwn-kernel:latest",
      "gateway": "proofblade/ctf-egress-gateway:latest"
    },
    "commandWaitMs": 30000,
    "commandHardTimeoutMs": 600000,
    "outputPreviewBytes": 50000,
    "staleContainerTtlMs": 3600000
  },
  "tools": {
    "outputRewrite": {
      "provider": "rtk",
      "rtkCommand": "rtk",
      "fallback": "builtin",
      "rewriteTimeoutMs": 5000,
      "maxRawBytes": 1048576
    }
  },
  "modelProfiles": {
    "executor": {
      "provider": "lmstudio",
      "api": "openai-completions",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "model": "auto",
      "modelDiscoveryPath": "/models",
      "apiKeyEnv": "LMSTUDIO_API_KEY",
      "contextWindow": 200000,
      "maxTokens": 16384,
      "requestTimeoutMs": 120000,
      "maxRetries": 4,
      "maxRetryDelayMs": 15000,
      "input": ["text", "image"]
    }
  }
}
