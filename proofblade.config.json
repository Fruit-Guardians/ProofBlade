{
  "schemaVersion": 1,
  "runtime": {
    "piVersion": "0.83.0"
  },
  "storage": {
    "runsDir": "runs",
    "fixturesDir": "fixtures/runtime"
  },
  "tools": {
    "outputRewrite": {
      "provider": "rtk",
      "rtkCommand": "rtk",
      "fallback": "builtin",
      "rewriteTimeoutMs": 5000,
      "maxRawBytes": 1048576
    }
  },
  "modelProfiles": {
    "executor": {
      "provider": "lmstudio",
      "api": "openai-completions",
      "baseUrl": "http://127.0.0.1:1234/v1",
      "model": "auto",
      "modelDiscoveryPath": "/models",
      "apiKeyEnv": "LMSTUDIO_API_KEY",
      "contextWindow": 20000,
      "maxTokens": 2048,
      "requestTimeoutMs": 120000,
      "maxRetries": 1,
      "input": ["text", "image"]
    }
  }
}
